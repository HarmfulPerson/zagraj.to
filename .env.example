# Copy to .env.local and adjust. Never commit .env.local.

# SQLite database file, relative to the project root (where prisma.config.ts lives).
# Integration tests always use file:./test.db (see vitest.config.mts), never this file.
DATABASE_URL="file:./dev.db"

# Secret used to encrypt the DJ session cookie (iron-session). At least 32 characters.
# Required in production. Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-output-of-openssl-rand-hex-32"

# Public base URL of the app, used to build guest links and QR codes (`<url>/e/<code>`).
# Set to the real domain in production. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe billing (ticket 012). All three are needed; without any of them the subscription page shows
# "Płatności nie są skonfigurowane" and POST /api/stripe/webhook answers 503. Use test-mode values in dev.
# Secret API key: Stripe Dashboard → Developers → API keys (sk_test_... in test mode).
STRIPE_SECRET_KEY=""
# Webhook signing secret: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook` in dev,
# or Dashboard → Developers → Webhooks → endpoint → Signing secret in production (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# Id of the recurring Pro price (25 PLN / month): Dashboard → Product catalog → Pro → price id (price_...).
STRIPE_PRICE_PRO=""
